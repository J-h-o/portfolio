# Canonical public URL. Change this for the final domain.
NEXT_PUBLIC_SITE_URL=https://joanisallushi.com

# Cal.com full event URL or username/event path. The locale-specific values
# take precedence, so separate translated event descriptions can be used.
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_CAL_LINK_EN=
NEXT_PUBLIC_CAL_LINK_EL=

# Optional: enables direct delivery from the contact form through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Allushi Website <website@joanisallushi.com>
CONTACT_TO_EMAIL=contact@joanisallushi.com
